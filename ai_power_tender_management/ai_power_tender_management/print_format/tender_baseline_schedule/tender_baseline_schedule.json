 "html": "<div dir=\"rtl\" style=\"font-family:'Tahoma','Segoe UI',Arial,sans-serif;color:#1f2430;\">\n\t{#- wkhtmltopdf ignores CSS `@page`. Frappe reads page geometry from a rule\n\t    that targets `.print-format` exactly, so orientation and sheet size must\n\t    be declared there or the schedule prints on a 210mm portrait page. -#}\n\t<style>\n\t\t.print-format { orientation: landscape; page-size: A3; margin-top: 10mm;\n\t\t\tmargin-bottom: 12mm; margin-left: 10mm; margin-right: 10mm; }\n\t\t{{ schedule_css() }}\n\t\t.sched-head { background:#1f3864; color:#fff; padding:10px 14px; margin-bottom:12px; }\n\t\t.sched-head h1 { margin:0; font-size:15px; color:#fff; }\n\t\t.sched-head .meta { font-size:10px; opacity:.85; margin-top:4px; }\n\t\t.sched-head .meta span { margin-left:18px; }\n\t</style>\n\n\t{%- set schedule_html = build_schedule_html(doc) -%}\n\t{% if schedule_html %}\n\t\t<div class=\"sched-head\">\n\t\t\t<h1>\u0627\u0644\u062c\u062f\u0648\u0644 \u0627\u0644\u0632\u0645\u0646\u064a \u0627\u0644\u0623\u0633\u0627\u0633\u064a \u0644\u0644\u0645\u0634\u0631\u0648\u0639</h1>\n\t\t\t<div class=\"meta\">\n\t\t\t\t<span>{{ doc.tender_name_ar or doc.tender_name or \"\" }}</span>\n\t\t\t\t{% if doc.tender_number %}<span><b>\u0631\u0642\u0645 \u0627\u0644\u0645\u0646\u0627\u0641\u0633\u0629:</b> {{ doc.tender_number }}</span>{% endif %}\n\t\t\t\t{% if doc.client_name %}<span><b>\u0627\u0644\u062c\u0647\u0629:</b> {{ doc.client_name }}</span>{% endif %}\n\t\t\t</div>\n\t\t</div>\n\t\t{{ schedule_html | safe }}\n\t{% else %}\n\t\t<p style=\"color:#999;\">{{ _(\"No schedule activities generated yet.\") }}</p>\n\t{% endif %}\n</div>\n",
